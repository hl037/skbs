#compdef skbs

_skbs_completion() {
    local -a completions
    local cur prev
    (( ! $+commands[skbs] )) && return 1

    cur="${words[CURRENT]}"
    prev="${words[CURRENT-1]}"

    if [[ "$prev" == "gen" || "$prev" == "g" ]]; then
        completions=("${(@f)$(skbs _complete-templates "$cur" 2>/dev/null)}")
        compadd -U -a completions
        return 0
    fi

    _files
}

compdef _skbs_completion skbs;
