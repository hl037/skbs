                    COMPREPLY=()
                    ;;
                esac
                ;;
            esac
          fi
          ;;
        "install-defaults")
          if [[ ${cur} == -* ]]; then
            local -a _c=("--symlink" "-s" "--no-symlink" "--help" "-h" "--version")
            COMPREPLY=()
            for _x in "${_c[@]}"; do
