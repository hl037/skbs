_skbs_completion() {
    local cur prev candidates
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    if [[ "$prev" == "gen" || "$prev" == "g" ]]; then
        candidates=$("${COMP_WORDS[0]}" _complete-templates "$cur" 2>/dev/null)
        COMPREPLY=( $(compgen -W "$candidates" -- "$cur") )
        return 0
    fi

    COMPREPLY=( $(compgen -f -- "$cur") )
    return 0
}

_skbs_completion_setup() {
    complete -o nosort -F _skbs_completion skbs
}

_skbs_completion_setup;
