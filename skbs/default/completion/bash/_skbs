        "u")
          if [[ ${cur} == -* ]]; then
            local -a _c=("--name" "--help" "-h" "--version")
            COMPREPLY=()
            for _x in "${_c[@]}"; do
              [[ "$_x" == "${cur}"* ]] && COMPREPLY+=("$_x")
            done
          else
            local _value_prev="${prev}"
            if [[ "$_value_prev" == "=" && $COMP_CWORD -ge 2 ]]; then
              _value_prev="${COMP_WORDS[COMP_CWORD-2]}"
            fi
            case "$_value_prev" in
